# Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: For cloud deployments (Render, Heroku, etc.)
# HOST=127.0.0.1
# PORT=8000

# --- Loss recovery email alerts ---
# Gmail: enable 2FA, create an App Password, use smtp.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senin@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=senin@gmail.com
ALERT_EMAIL_TO=senin@gmail.com
SMTP_USE_TLS=true
# both = kâra geçince + zarardayken yükseliş
# breakeven = sadece alışa ulaşınca
# rise = sadece zarardayken günlük yükseliş
ALERT_MODE=both
# Zarardaki hisse bugün en az bu % yükselirse mail
ALERT_RISE_PCT=3
